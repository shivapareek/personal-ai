<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">@bool/lightBars</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:switchStyle">@style/IosSwitch</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="CallTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/callBg</item>
        <item name="android:statusBarColor">@color/callBg</item>
        <item name="android:navigationBarColor">@color/callBg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="IosSwitch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:switchMinWidth">51dp</item>
        <item name="android:background">@null</item>
        <item name="android:showText">false</item>
    </style>

    <style name="LargeTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Footnote">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
