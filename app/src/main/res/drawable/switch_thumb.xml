<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="32dp" android:height="32dp">
                <shape android:shape="oval"><solid android:color="#00000000" /></shape>
            </item>
            <item android:width="24dp" android:height="24dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="#FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="32dp" android:height="32dp">
                <shape android:shape="oval"><solid android:color="#00000000" /></shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/tertiary" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
